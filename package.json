{
  "name": "diagramai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0", "npm": ">=11.0.0" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "prepare:reference": "node scripts/prepare-reference.mjs",
    "dev": "npm run prepare:reference && npm run dev -w @diagramai/web",
    "build:web": "npm run prepare:reference && npm run build -w @diagramai/web",
    "build:web:desktop": "node scripts/build-desktop-web.mjs",
    "preview": "npm run preview -w @diagramai/web",
    "lint": "eslint . && node scripts/prepare-reference.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-desktop.ps1",
    "test:live": "playwright test --config playwright.live.config.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "desktop:dev": "npm run dev -w @diagramai/desktop",
    "desktop:build": "npm run build -w @diagramai/desktop",
    "check:environment": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-environment.ps1",
    "spike:neon": "node scripts/check-neon.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "5.1.1"
  }
}
