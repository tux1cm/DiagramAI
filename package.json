{
  "name": "diagramai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare:reference": "node scripts/prepare-reference.mjs && node scripts/extract-ui-css.mjs",
    "dev": "npm run prepare:reference && npm run dev -w @diagramai/web",
    "build:web": "npm run prepare:reference && npm run build -w @diagramai/web",
    "build:web:desktop": "node scripts/build-desktop-web.mjs",
    "preview": "npm run preview -w @diagramai/web",
    "lint": "eslint . && node scripts/prepare-reference.mjs --check && node scripts/extract-ui-css.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:p5": "vitest run tests/unit/sync-api.test.ts tests/unit/sync-coordinator.test.ts tests/unit/sync-journal.test.ts tests/unit/workspace.test.ts tests/unit/workspace-library.test.ts",
    "check:p5": "npm run lint && npm run typecheck && npm run test:p5",
    "test:p5:neon": "node scripts/test-sync-neon.mjs",
    "test:p5:web": "playwright test --config playwright.p5.config.ts",
    "test:e2e": "playwright test",
    "test:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-desktop.ps1",
    "test:desktop:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-desktop.ps1 -Scope full",
    "test:live": "playwright test --config playwright.live.config.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "desktop:dev": "npm run dev -w @diagramai/desktop",
    "desktop:build": "npm run build -w @diagramai/desktop",
    "check:environment": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-environment.ps1",
    "spike:neon": "node scripts/check-neon.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fake-indexeddb": "6.2.8",
    "globals": "^16.0.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "5.1.1"
  }
}
