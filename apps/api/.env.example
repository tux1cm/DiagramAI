# Backend ONLY. DATABASE_URL is injected by the linked Neon branch.
DATABASE_URL=
# Exact origins, no paths or wildcards. Add the real Pages origin after confirmation.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# P5 stays disabled until migrations/security/sync integration checks pass.
SYNC_ENABLED=false
# Server-only random >=32-character secret for hashing rate-limit identities.
SYNC_RATE_SECRET=
